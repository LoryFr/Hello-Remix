{
  "name": "hello-remix",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --watch --import remix/node-tsx server.ts",
    "start": "NODE_ENV=production node --import remix/node-tsx main.ts",
    "build:css": "npx @tailwindcss/cli -i ./app/ui/global.css -o ./public/style.css",
    "build:css:watch": "npx @tailwindcss/cli -i ./app/ui/global.css -o ./public/style.css --watch",
    "test": "NODE_ENV=test node --import remix/node-tsx --test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "remix": "^3.0.0-beta.5"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest",
    "@tailwindcss/cli": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "tailwindcss": "^4.3.2"
  }
}
